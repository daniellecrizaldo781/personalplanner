PORT=3000
# Database file path
DATABASE_PATH=./data/personalplanner.db.json
# Session/JWT secrets (change in production)
SESSION_SECRET=change-me-in-production
JWT_SECRET=change-me-jwt-secret
# Web Push VAPID keys (generate with: node -e "const webpush=require('web-push');const k=webpush.generateVAPIDKeys();console.log(k.publicKey,k.privateKey);")
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Base URL (set to https://personalplanner.daniellecrizaldo.com in production)
BASE_URL=http://localhost:3000
# Auth (future use)
AUTH_ENABLED=false
